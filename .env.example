# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ADS API token -- https://ui.adsabs.harvard.edu/user/settings/token
# Needed only for `gwn corpus discover`.
ADS_DEV_KEY=

# Needed only for `gwn classify`.
ANTHROPIC_API_KEY=

# Optional overrides
# GWN_CLASSIFY_MODEL=claude-haiku-4-5
# GWN_DB_URL=sqlite:////absolute/path/to/gwnetwork.db
